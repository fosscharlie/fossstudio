# Extra sites served by this Caddy instance (other apps sharing the same
# host drop their own .caddy site files in the mounted sites folder; the
# glob is harmless when the folder is empty).
import /etc/caddy/sites/*.caddy

{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:{$HTTP_PORT}
}

# Optional old domain forwarding to the real one so old links keep
# working; harmless no-op when LEGACY_DOMAIN is unset
{$LEGACY_DOMAIN::65534} {
	redir https://{$DOMAIN}{uri} permanent
}
