# FOSS Studio configuration
# Copy to .env and fill in. Never commit .env.

# The public domain the studio runs at
DOMAIN=fossstudio.fosscharlie.uk

# Public IPv4 of the VPS (used by the media engine to tell guests where to send video)
PUBLIC_IP=

# Port the Node app listens on (Caddy proxies to this; not exposed publicly)
HTTP_PORT=3000

# Initial host login password — change it from the dashboard after first login
HOST_PASSWORD=

# Random secret for session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Shared secret between the app and the TURN relay (generate with: openssl rand -hex 32)
TURN_SECRET=

# Email settings for alerts (any standard SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL=
