# FOSS Studio configuration
# Copy to .env and fill in. Never commit .env.

# The public domain the studio runs at
DOMAIN=studio.example.com

# Public IPv4 of the VPS (used by the media engine to tell guests where to send video)
PUBLIC_IP=

# Port the Node app listens on (your reverse proxy points here; not exposed publicly)
HTTP_PORT=3000

# Optional: address the app binds to (default 127.0.0.1, reachable only by
# a proxy on the same host). Set to a Tailscale IP for proxyless tailnet
# use, or 0.0.0.0 if your proxy runs in a separate container/host.
# Never expose the app port itself to the open internet.
#BIND_HOST=127.0.0.1

# Optional: hostname or IP guests use to reach the TURN relay (defaults to
# DOMAIN). Set this if DOMAIN is behind Cloudflare (proxied DNS or a
# tunnel) - relay traffic on port 3478 must reach this server directly,
# so use an unproxied hostname or the raw server IP here.
#TURN_HOST=

# Initial host login password — change it from the dashboard after first login
HOST_PASSWORD=

# Random secret for session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=

# Shared secret between the app and the TURN relay (generate with: openssl rand -hex 32)
TURN_SECRET=

# Optional: an old domain that should forward to DOMAIN (leave unset if none)
#LEGACY_DOMAIN=old.example.com

# Optional: folder of extra .caddy site files served by the bundled Caddy,
# for other apps sharing this host's ports 80/443 (leave unset if none)
#CADDY_SITES_PATH=/opt/caddy/sites

# Email settings for alerts (any standard SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ALERT_EMAIL=
